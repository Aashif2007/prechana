# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# "demo" = keyword-based stand-in (no API key needed). "gemini" = real Gemini.
AI_PROVIDER=demo

# Aadhaar identity verification. "demo" simulates the OTP flow (OTP is always
# 123456, no real UIDAI call). "real" requires becoming a UIDAI-licensed
# Sub-AUA/KUA via a provider such as Setu or Surepass, and implementing
# RealAadhaarProvider in services/identity/aadhaarVerification.ts.
AADHAAR_PROVIDER=demo
NEXT_PUBLIC_AADHAAR_DEMO=true
